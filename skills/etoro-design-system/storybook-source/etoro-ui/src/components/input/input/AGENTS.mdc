## Component Lifecycle

### 1. Initialization (`init-props.ts`)

```typescript
export function initializeProps(props: EtInputProps) {
  return {
    stateConfig: props.state,
    appearanceConfig: props.appearance || {},
    validationConfig: props.validation || {},
    advancedConfig: props.advanced || {},
  };
}
```

### 2. State Management (`use-input-state.ts`)

```typescript
export function useInputState(value: string, onChangeText: (text: string) => void, type: InputType) {
  const [isFocused, setIsFocused] = useState(false);
  const [isPasswordVisible, setIsPasswordVisible] = useState(false);

  const handleFocus = () => setIsFocused(true);
  const handleBlur = () => setIsFocused(false);
  const togglePasswordVisibility = () => setIsPasswordVisible((prev) => !prev);

  return {
    isFocused,
    isPasswordVisible,
    handleFocus,
    handleBlur,
    togglePasswordVisibility,
  };
}
```

### 3. Animation Setup (`use-input-animations.ts`)

```typescript
export function useInputAnimations({ isFocused, hasValue, hasPrefix, prefixWidth = 32 }: UseInputAnimationsProps) {
  const labelAnim = useSharedValue(isFocused || hasValue ? 1 : 0);

  useEffect(() => {
    labelAnim.value = withSpring(isFocused || hasValue ? 1 : 0, {
      damping: 20,
      stiffness: 300,
    });
  }, [isFocused, hasValue]);

  // ... animation style calculations
}
```

