```

3. **Update spacing calculations if size changes** (`layout-calculations.ts`)

### Changing the Gap Size

**Current:** 12px gap

**To change:**

```typescript
// In layout-calculations.ts:
const GAP_SIZE = 16; // New gap size

export function calculatePrefixWidth(hasPrefix: boolean, prefixSize?: number): number {
  if (!hasPrefix) return 0;
  const iconSize = prefixSize || 20;
  return iconSize + GAP_SIZE; // Use constant
}

export function calculateInputPadding(
  hasPrefix: boolean,
  hasSuffix: boolean,
  isPassword: boolean,
  prefixSize?: number,
  suffixSize?: number,
): { paddingStart?: number; paddingEnd?: number } {
  const padding: { paddingStart?: number; paddingEnd?: number } = {};

  if (hasPrefix) {
    const iconSize = prefixSize || 20;
    padding.paddingStart = iconSize + GAP_SIZE;
  }

  if (hasSuffix || isPassword) {
    const iconSize = suffixSize || 20;
    padding.paddingEnd = iconSize + GAP_SIZE;
  }

  return padding;
}
```

**Warning:** Changing the gap affects all instances globally.

