## Usage Examples

### Basic Usage

```tsx
import { QuestionsForm, type QuestionsFormConfig, type QuestionsFormValues } from 'etoro-ui/questions-form';

const config: QuestionsFormConfig = {
  questions: [
    {
      id: 'q1',
      type: 'input',
      text: 'What is your name?',
      subText: 'Enter your full name',
    },
  ],
};

function MyScreen() {
  const handleSubmit = (values: QuestionsFormValues) => {
    console.log('Submitted:', values);
  };

  return <QuestionsForm config={config} onSubmit={handleSubmit} />;
}
```

### With Ref (Imperative Control)

```tsx
import { useRef } from 'react';
import { QuestionsForm, type QuestionsFormRef } from 'etoro-ui/questions-form';

function MyScreen() {
  const formRef = useRef<QuestionsFormRef>(null);

  const handleExternalSubmit = () => {
    formRef.current?.submit();
  };

  const handleGetValues = () => {
    const values = formRef.current?.getValues();
    console.log('Current values:', values);
  };

  return (
    <>
      <QuestionsForm ref={formRef} config={config} onSubmit={handleSubmit} />
      <Button onPress={handleExternalSubmit} title="Submit from outside" />
      <Button onPress={handleGetValues} title="Get values" />
    </>
  );
}
```

### With Value Change Callback

```tsx
<QuestionsForm
  config={config}
  onValuesChange={(diff) => {
    console.log('Current values:', diff.current);
    console.log('Changed fields:', diff.diff);
    console.log('Valid:', diff.valid);
  }}
  onSubmit={handleSubmit}
/>
```

### With Custom Submit Label and Footer

```tsx
<QuestionsForm
  config={config}
  submitLabel="Next"
  footerExtra={
    <Text variant="body-sm" style={styles.footerHint}>
      Step 1 of 3
    </Text>
  }
  onSubmit={handleSubmit}
/>
```
