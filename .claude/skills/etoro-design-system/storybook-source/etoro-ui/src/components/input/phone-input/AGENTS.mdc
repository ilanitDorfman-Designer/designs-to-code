## Entry Points & Contracts

### `EtPhoneInput` (main component)

```tsx
<EtPhoneInput
  prefix: string                    // Required - dial code (e.g., "+44", "+1", "+972")
  isoCode: string                   // Required - ISO country code (e.g., "GB", "US", "IL")
  placeholder: string               // Required - placeholder text (e.g., "Number")
  defaultValue?: string             // Initial phone number (uncontrolled mode)
  value?: string                    // Controlled phone number — switches the input into controlled mode
  selection?: { start: number; end?: number } // Controlled caret/selection — pair with `value` for cursor-aware editing
  showVirtualKeyboard?: boolean     // When false, suppresses the native keyboard (e.g. when using a custom on-screen keypad). Default: true
  error?: string | null             // Error message (renders below input)
  disabled?: boolean                // Disables the number input (default: false)
  prefixDisabled?: boolean          // Disables the prefix section (default: false)
  autoFocus?: boolean               // Auto-focus number input on mount (default: false)
  onChangeText?: (value: string) => void    // Phone number change callback
  onSelectionChange?: (selection: { start: number; end: number }) => void  // Caret / selection moved (tap, drag, native key nav)
  onFocus?: () => void              // Number input focused
  onBlur?: () => void               // Number input blurred
  onSubmitEditing?: (value: string) => void // Enter/Return pressed
  onPrefixPress?: () => void        // Prefix section pressed (open country picker)
  style?: StyleProp<ViewStyle>      // Container style override
  testID?: string                   // Test identifier
/>
```

### `EtPhoneInput.Provider` (for external composition)

```tsx
<EtPhoneInput.Provider
  prefix: string                    // Required - dial code (e.g., "+44", "+1", "+972")
  isoCode: string                   // Required - ISO country code (e.g., "GB", "US", "IL")
  placeholder: string               // Required - placeholder text (e.g., "Number")
  defaultValue?: string             // Initial phone number (uncontrolled mode)
  error?: string | null             // Error message (passed to ErrorText via context)
  disabled?: boolean                // Disables the number input (default: false)
  prefixDisabled?: boolean          // Disables the prefix section (default: false)
  autoFocus?: boolean               // Auto-focus number input on mount (default: false)
  onChangeText?: (value: string) => void    // Phone number change callback
  onFocus?: () => void              // Number input focused
  onBlur?: () => void               // Number input blurred
  onSubmitEditing?: (value: string) => void // Enter/Return pressed
  onPrefixPress?: () => void        // Prefix section pressed (open country picker)
  testID?: string                   // Test identifier (passed to subcomponents)
  children: ReactNode               // Subcomponents or custom layout
>
  {children}
</EtPhoneInput.Provider>
```

Note: `EtPhoneInput.Provider` does NOT accept a `style` prop - apply styles to your custom layout wrapper when using external composition. The `testID` is passed to subcomponents automatically (e.g., `${testID}-prefix`, `${testID}-number`).

### Types

```typescript
export interface EtPhoneInputProps {
  /** Dial code including '+' sign (e.g., "+44") */
  prefix: string;

  /** ISO country code for the flag (e.g., "IL", "US", "GB") */
  isoCode: string;

  /** Placeholder text for the number field */
  placeholder: string;

  /** Initial phone number value (uncontrolled mode) */
  defaultValue?: string;

  /** Error message to display below input */
  error?: string | null;

  /** Disables the number input field */
  disabled?: boolean;

  /** Disables the prefix section */
  prefixDisabled?: boolean;

  /** Auto-focus number field on mount */
  autoFocus?: boolean;

  /** Called when phone number text changes */
  onChangeText?: (value: string) => void;

  /** Called when number field gains focus */
  onFocus?: () => void;

  /** Called when number field loses focus */
  onBlur?: () => void;

  /** Called when Enter/Return key is pressed, returns current value */
  onSubmitEditing?: (value: string) => void;

  /** Called when prefix section is pressed */
  onPrefixPress?: () => void;

  /** Container style override */
  style?: StyleProp<ViewStyle>;

  /** Test identifier */
  testID?: string;
}
```

## Usage Patterns

### Basic phone input (simplest)

```tsx
<EtPhoneInput prefix="+44" isoCode="GB" placeholder="Number" onChangeText={setPhoneNumber} onPrefixPress={openCountryPicker} />
```

### With default value (prefilled)

```tsx
<EtPhoneInput
  prefix="+1"
  isoCode="US"
  placeholder="Number"
  defaultValue="2332332330"
  onChangeText={setPhoneNumber}
  onPrefixPress={openCountryPicker}
/>
```

### With error state

```tsx
<EtPhoneInput
  prefix="+972"
  isoCode="IL"
  placeholder="Number"
  defaultValue="12345"
  error="Invalid phone number"
  onChangeText={setPhoneNumber}
  onPrefixPress={openCountryPicker}
/>
```

### Disabled state

```tsx
<EtPhoneInput prefix="+44" isoCode="GB" placeholder="Number" defaultValue="233233233" disabled prefixDisabled />
```

### With all callbacks

```tsx
<EtPhoneInput
  prefix="+44"
  isoCode="GB"
  placeholder="Number"
  autoFocus
  onChangeText={handlePhoneNumberChange}
  onFocus={handleFocus}
  onBlur={handleBlur}
  onSubmitEditing={handleSubmit}
  onPrefixPress={handleOpenCountryPicker}
/>
```

### Cursor-aware editing with a custom keyboard (controlled mode)

When the parent drives keystrokes from an on-screen keypad (e.g. `EtKeyboard.Keys`), the
native soft keyboard is suppressed via `showVirtualKeyboard={false}`. The parent must
then own both the text and the caret so synthesised keys land at the user's cursor — not
appended blindly to the end. Pair `value` + `selection` + `onSelectionChange`:

```tsx
const [value, setValue] = useState('');
const [selection, setSelection] = useState({ start: 0, end: 0 });

const handleKey = (digit: string) => {
  setValue((prev) => prev.slice(0, selection.start) + digit + prev.slice(selection.end));
  setSelection({ start: selection.start + 1, end: selection.start + 1 });
};

<EtPhoneInput
  prefix="+972"
  isoCode="IL"
  placeholder="Number"
  value={value}
  selection={selection}
  onSelectionChange={setSelection}    // sync caret on tap / drag
  showVirtualKeyboard={false}         // suppress native keyboard
  onChangeText={setValue}
  onPrefixPress={openCountryPicker}
/>;
```

**Why this matters:** without controlled `selection`, the native iOS / Android `TextInput`
manages a caret of its own that the parent cannot read in time to splice the next keystroke.
The result is the legacy "always append to end" bug (PA-188). Both `value` and `selection`
must be updated **in the same handler** so React's automatic batching keeps them in sync.

