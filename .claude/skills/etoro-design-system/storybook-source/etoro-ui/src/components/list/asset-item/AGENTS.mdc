  <EtAssetItem.Content>
    <EtAssetItem.Symbol>AAPL</EtAssetItem.Symbol>
    <EtAssetItem.Name>Apple Inc</EtAssetItem.Name>
  </EtAssetItem.Content>
  <EtAssetItem.Price value="$186.79" />
  <EtAssetItem.Change value="1.95 (-1.03%)" sentiment="negative" />
</EtAssetItem>

// Compact row inside a custom layout (no price, custom horizontal padding)
<EtAssetItem size="small" style={{ paddingHorizontal: 0 }}>
  <EtAssetItem.Logo source={asset.logoUri} />
  <EtAssetItem.Content>
    <EtAssetItem.Symbol>AAPL</EtAssetItem.Symbol>
    <EtAssetItem.Name>Apple Inc</EtAssetItem.Name>
  </EtAssetItem.Content>
</EtAssetItem>

// Trailing CTA (search results)
<EtAssetItem onPress={openAsset}>
