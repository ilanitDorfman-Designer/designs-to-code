</EtAssetItem>

// Trading-view layout (Buy/Sell quote chips)
<EtAssetItem layout="trading-view">
  <EtAssetItem.Logo source={asset.logoUri} />
  <EtAssetItem.Content>
    <EtAssetItem.Symbol>AUS200</EtAssetItem.Symbol>
  </EtAssetItem.Content>
