  <EtWizard.TopbarEnd>
    <EtIconButton iconName="moreVertical" size={24} onPress={openMenu} />
  </EtWizard.TopbarEnd>

  <EtWizard.Step>
    <EtWizard.Title>Feature 1</EtWizard.Title>
    <EtWizard.Subtitle>Auto-advances in 3 seconds.</EtWizard.Subtitle>
    <EtWizard.Footer>
      <EtWizard.Button>
        <EtWizard.Button.Icon name="star" />
        <EtWizard.Button.Label>Next</EtWizard.Button.Label>
      </EtWizard.Button>
    </EtWizard.Footer>
  </EtWizard.Step>

  <EtWizard.Step>
    <EtWizard.Title>Feature 2</EtWizard.Title>
    <EtWizard.Footer>
      <EtWizard.Button onPress={handleComplete}>Get Started</EtWizard.Button>
    </EtWizard.Footer>
